# PostgreSQL / Neon connection string. Keep real credentials out of Git.
# Example format only; replace with your own Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated exact frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional upstream provider configuration.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=https://router.project-osrm.org
GREENROUTE_USER_AGENT=GreenRouteAI/3.0 (contact: replace-with-your-project-contact)
