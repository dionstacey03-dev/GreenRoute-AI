# Neon PostgreSQL connection string. Keep real credentials out of Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Clerk development keys. The publishable key belongs in the frontend .env.
# Never put CLERK_SECRET_KEY or CLERK_JWT_KEY in VITE_ variables.
CLERK_SECRET_KEY=sk_test_replace_me
# Optional but recommended: PEM public key from Clerk Dashboard > API keys > JWT public key.
CLERK_JWT_KEY=

# Exact frontend origins. These are also used as Clerk authorized parties.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional upstream provider configuration.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=https://router.project-osrm.org
GREENROUTE_USER_AGENT=GreenRouteAI/3.0 (contact: replace-with-your-project-contact)
